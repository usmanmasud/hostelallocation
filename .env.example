# Copy to .env and adjust. All values are optional in development.
PORT=3000
NODE_ENV=development

# Required in production: a long random string used to sign session cookies.
SESSION_SECRET=

# SQLite database file (created automatically).
DATABASE_PATH=data/hostel.db

# Time zone used when displaying dates.
APP_TIMEZONE=Africa/Lagos

# How often (in minutes) the background job checks for complaints to escalate.
ESCALATION_CHECK_MINUTES=15

# First-run System Administrator account. If the password is left empty,
# a random one is generated and printed to the console once.
BOOTSTRAP_ADMIN_EMAIL=admin@hostel.local
BOOTSTRAP_ADMIN_PASSWORD=

# SMTP settings for emailing the Dean of Student Affairs on escalation.
# When SMTP_HOST is empty, emails are recorded in the outbox instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Smart Hostel <no-reply@hostel.local>"
