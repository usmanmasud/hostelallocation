<%- include('../partials/head') %>
<div class="auth">
  <%- include('../partials/auth-aside') %>
  <main class="auth-main">
    <div class="auth-card">
      <h2>Sign in</h2>
      <p class="muted">Students, hostel administrators and system administrators all sign in here.</p>
      <%- include('../partials/flash') %>
      <% if (typeof error !== 'undefined' && error) { %><div class="alert error" role="alert"><%= error %></div><% } %>
      <form method="post" action="/login" class="card" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="stack">
          <div class="field <%= errors.email ? 'invalid' : '' %>">
            <label for="email">Email address</label>
            <input type="email" id="email" name="email" value="<%= values.email || '' %>" autocomplete="username" required autofocus>
            <%- include('../partials/field-error', { name: 'email' }) %>
          </div>
          <div class="field <%= errors.password ? 'invalid' : '' %>">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" autocomplete="current-password" required>
            <%- include('../partials/field-error', { name: 'password' }) %>
          </div>
          <button type="submit" class="btn block">Sign in</button>
        </div>
      </form>
      <p class="muted small" style="margin-top:1rem">New student? <a href="/register">Create your account</a>.</p>
    </div>
  </main>
</div>
<%- include('../partials/foot') %>
